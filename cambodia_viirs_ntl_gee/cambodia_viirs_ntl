var ROI = phnom_penh.merge(kandal).union();
var data_2425 = VIIRS.filterDate('2024-09-01', '2025-09-01');
var data_2526 = VIIRS.filterDate('2025-09-01', '2026-09-01');

// Method takes in the dataset images and filters out cloud coverage less than 2.
// Updates the images and returns the filtered images back.
function imageProcess(image) {
  var cloudImage = image.select('cf_cvg');
  var filteredCloudImage = cloudImage.gt(2);
  return image.updateMask(filteredCloudImage);
}

// Map datasets
var unprocessed_2425 = data_2425.select('avg_rad').mean().clip(ROI);
var unprocessed_2526 = data_2526.select('avg_rad').mean().clip(ROI);
var processed_2425 = data_2425.map(imageProcess).select('avg_rad').mean().clip(ROI);
var processed_2526 = data_2526.map(imageProcess).select('avg_rad').mean().clip(ROI);
var ntl_diff = processed_2526.subtract(processed_2425);

// Map layer parameters
var param = {min: 0, max:60, palette: ['000000', '00FF00']};
var param_diff = {min: -15, max: 15, palette: ['FF0000', '000000', '00FF00']};

Map.addLayer(unprocessed_2425, param, 'unprocessed 2025-2026');
Map.addLayer(unprocessed_2526, param, 'unprocessed 2024-2025');
Map.addLayer(processed_2526, param, 'processed 2025-2026');
Map.addLayer(processed_2425, param, 'processed 2024-2025');
Map.addLayer(ntl_diff, param_diff, 'night time light difference');
Map.setCenter(104.8885, 11.5621, 10);


